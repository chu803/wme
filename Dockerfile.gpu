# syntax=docker/dockerfile:1
# ==============================================================================
#  AI 智能水印擦除工作台 —— GPU 版 Docker 构建文件（可选）
#  阶段 198 · D1 产品化（GPU/API）· D1-Stage 3：把 Docker GPU 配方从注释落地为
#  可选构建文件，使「带显卡的机器」能直接 `docker build -f Dockerfile.gpu` 得到
#  启用 CUDA 推理的镜像，配合 `python main.py --api` 或网页界面服务。
#
#  与默认 Dockerfile 的区别：
#    1. 基础镜像换成 `nvidia/cuda:12.8.1-runtime-ubuntu22.04`（自带 CUDA 运行库，
#       推理只需运行时库，不需要 nvcc 等开发库）。**12.8 是 RTX 50 系（Blackwell /
#       sm_120）的下限**——阶段 207 修正：原先的 12.1.1 + cu121 组合只覆盖到 sm_90，
#       在 50 系卡上会因缺少对应 kernel 而不可用。
#    2. torch 从 `requirements-gpu.txt` 安装（CUDA 版）——这是启用显卡加速的关键；
#       默认 Dockerfile 装的是 CPU 版 torch。
#       ⚠ **单一真值来源**（阶段 207）：版本与 CUDA 源都由 `requirements-gpu.txt` 决定，
#       本文件**不再硬编码** torch 版本，避免「两处清单慢慢漂移」（同 184/187 教训）。
#    3. 仍保持多阶段 + HEALTHCHECK + 非 root + `WME_` 前缀环境变量等全部契约。
#
#  用法：
#    build ：docker build -f Dockerfile.gpu -t watermark-eraser-gpu .
#    运行（网页）：docker run --gpus all -p 7860:7860 -p 7861:7861 \
#                   -e WME_SERVER_HOST=0.0.0.0 watermark-eraser-gpu
#    运行（仅REST）：docker run --gpus all -p 7861:7861 \
#                   -e WME_SERVER_HOST=0.0.0.0 watermark-eraser-gpu python main.py --api
#
#  前置：宿主机需装好 NVIDIA 驱动 + 安装 nvidia-container-toolkit，否则 --gpus 无效。
#  说明：本文件只保证「镜像内 torch 为 CUDA 版 + 设备自动选择逻辑（config.DEVICE_MODE
#        默认 auto）会在检测到 CUDA 时启用显卡」；具体加速倍数取决于机型与图尺寸。
# ==============================================================================

ARG PYTHON_VERSION=3.11

# ------------------------------ Stage 1 · builder -----------------------------
# 用 nvidia/cuda runtime 基础镜像，既带 CUDA 运行库，又是 ubuntu，可装 python。
# CUDA 12.8：RTX 50 系（Blackwell / sm_120）所需下限（阶段 207 修正，原为 12.1.1）。
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04 AS builder

# 构建期：装 python + 编译工具链（部分依赖可能需就地编译）。
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3-pip python3.11-venv build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && python3.11 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# 先复制依赖清单（两份：完整依赖 + GPU 补充清单）。
COPY requirements.txt requirements-gpu.txt /tmp/

# 安装全部依赖到独立前缀 /install（runtime 阶段整体拷贝）。
# 第 1 步：按默认清单装（其中 torch 是 CPU 版，下一步会被 CUDA 版覆盖）。
RUN python3.11 -m pip install --no-cache-dir --prefix=/install \
         -r /tmp/requirements.txt

# 第 2 步：用 CUDA 版 torch 覆盖。**版本与 CUDA 源均取自 requirements-gpu.txt**
#   —— 本文件不硬编码，避免与清单漂移（单一真值来源）。
#   ⚠️ 这步是 GPU 镜像的「灵魂」：torch 必须是 CUDA 版，否则 DEVICE_MODE=auto
#      检测到 CUDA 也加载不了 GPU 权重（torch.cuda.is_available() 直接 False）。
#   `--no-deps`：避免把 CPU 版 torch 的依赖再拉一遍。
RUN python3.11 -m pip install --no-cache-dir --prefix=/install \
        --no-deps -r /tmp/requirements-gpu.txt

# ------------------------------ Stage 2 · runtime -----------------------------
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04 AS runtime

# 运行期系统库（OpenCV / Gradio 所需）+ python3.11 + ffmpeg（视频处理）。
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# 非 root 用户（最小权限原则）。
RUN useradd --create-home --uid 10001 appuser

WORKDIR /app

# 只拷「已安装的包」（builder 的 /install → 系统 site-packages），不带编译工具链。
COPY --from=builder /install /usr/local

# 拷源码并按 appuser 授权（运行期需写 outputs / cache / temp / logs / exports / models）。
COPY --chown=appuser:appuser . .
RUN mkdir -p outputs cache temp logs exports models \
    && chown -R appuser:appuser /app

# 容器内默认允许外网访问（WME_ 前缀！）；关掉 Gradio 遥测以保持离线。
# DEVICE_MODE 默认 auto：检测到 CUDA 即自动启用显卡，无需额外设置。
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GRADIO_ANALYTICS_ENABLED=False \
    WME_SERVER_HOST=0.0.0.0 \
    WME_SERVER_PORT=7860 \
    WME_SERVER_OPEN_BROWSER=False \
    WME_DEVICE_MODE=auto

# 暴露端口：
#   · 7860 —— Gradio 网页界面（config.SERVER_PORT 默认）
#   · 7861 —— 零依赖 REST 服务（server.py，需 `python main.py --api` 启动）
EXPOSE 7860
EXPOSE 7861

# 阶段 250 修**解释器错配（P0·确定性启动失败）**：本镜像装的是 `python3.11`
#   （依赖落在 `/usr/local/lib/python3.11/site-packages`），但 Ubuntu 22.04 自带的
#   `/usr/bin/python3` 是 **Python 3.10**——它只搜索 `python3.10` 的 dist-packages，
#   **找不到** python3.11 的 site-packages ⇒ 旧写法 `ENTRYPOINT ["python3", ...]`
#   启动即 `ModuleNotFoundError: No module named 'torch'`（gradio/opencv 同理）。
#   本机无 docker CLI 也能静态判定：ENTRYPOINT/CMD 的解释器必须与装依赖的解释器**同一个**。
#   这里做两件事（缺一不可）：
#     ① symlink：让 `python3` / `python` 也指向 3.11——使用户 `docker exec` 进去后
#        手工执行 `python3 xxx` 的行为与镜像内一致（否则 exec 进去是 3.10，同样找不到包）；
#     ② 下方 ENTRYPOINT / HEALTHCHECK **显式**写 `python3.11`——不依赖 symlink 即可正确。
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python

# HEALTHCHECK：轮询 Gradio 首页是否就绪（用容器自带 python3.11，免装 curl）。
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python3.11 -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('WME_SERVER_PORT','7860')+'/', timeout=4)"

USER appuser

# 入口：运行主程序（main.py 内部会做目录自检、模型就绪、启动 Gradio）。
#   ⚠ 必须显式 `python3.11`：镜像依赖装在 3.11，而系统 `python3` 是 3.10（见上方说明）。
#   仅跑 REST 时覆盖命令为 `python3.11 main.py --api`（见上方用法示例）。
ENTRYPOINT ["python3.11", "main.py"]
